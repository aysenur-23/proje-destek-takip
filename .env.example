# ══════════════════════════════════════════════════════════════════════════════
# Destek Takip — Ortam Değişkenleri
# Bu dosyayı .env.local olarak kopyalayın: cp .env.example .env.local
# ══════════════════════════════════════════════════════════════════════════════

# ── Uygulama URL ─────────────────────────────────────────────────────────────
# Geliştirme: http://localhost:3000 | Production: https://destektakip.com
NEXT_PUBLIC_APP_URL="https://destektakip.com"

# ── Firebase (Client SDK) ─────────────────────────────────────────────────────
# Firebase Console → Proje Ayarları → Genel → Web Uygulaması → Config
NEXT_PUBLIC_FIREBASE_API_KEY="AIzaSy..."
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="proje-destek-takip.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="proje-destek-takip"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="proje-destek-takip.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="123456789012"
NEXT_PUBLIC_FIREBASE_APP_ID="1:123456789012:web:abcdef1234567890"

# ── Firebase Admin SDK (Server-side) ─────────────────────────────────────────
# Firebase Console → Proje Ayarları → Hizmet Hesapları → Yeni özel anahtar oluştur
# JSON dosyasını indirin, aşağıdaki alanları doldurun:
FIREBASE_ADMIN_PROJECT_ID="proje-destek-takip"
FIREBASE_ADMIN_CLIENT_EMAIL="firebase-adminsdk-xxxxx@proje-destek-takip.iam.gserviceaccount.com"
# Private key içindeki \n satır sonlarını koruyun (tırnak içinde)
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQ...\n-----END PRIVATE KEY-----\n"

# ── PostgreSQL (Prisma) ───────────────────────────────────────────────────────
# Vercel Postgres: Dashboard → Storage → Create Database → .env.local'a kopyala
# Neon: https://neon.tech → Project → Connection string
DATABASE_URL="postgresql://kullanici:sifre@host:5432/veritabani?sslmode=require"

# ── Anthropic AI ──────────────────────────────────────────────────────────────
# https://console.anthropic.com → API Keys → Create Key
ANTHROPIC_API_KEY="sk-ant-api03-..."

# ── Resend (Email) ────────────────────────────────────────────────────────────
# https://resend.com → API Keys → Create API Key
# DNS kayıtlarınızı da eklemeyi unutmayın (bildirim@destektakip.com için)
RESEND_API_KEY="re_..."

# ── Kuveyt Türk Sanal POS ────────────────────────────────────────────────────
# KT POS yönetim panelinden alınır
KT_MERCHANT_ID="your_merchant_id"
KT_CUSTOMER_ID="your_customer_id"
KT_USERNAME="your_api_username"
KT_PASSWORD="your_api_password"

# ── Güvenlik ─────────────────────────────────────────────────────────────────
# Cron job'lar için gizli anahtar (en az 32 karakter, rastgele üretin)
# openssl rand -base64 32
CRON_SECRET="gizli-cron-anahtari-buraya-en-az-32-karakter"

# ── Admin ─────────────────────────────────────────────────────────────────────
# /admin paneline erişebilecek e-posta adresleri (virgülle ayrılmış)
NEXT_PUBLIC_ADMIN_EMAILS="admin@sirketiniz.com"
